---
import { site } from '../config/site';

const stations = [
  { key: 'java', label: site.lines.java, caption: 'Backends that don’t lose data' },
  { key: 'python', label: site.lines.python, caption: 'Pipelines people can trust' },
  { key: 'devops', label: site.lines.devops, caption: 'Shipping without the 6am panic' },
  { key: 'ai', label: site.lines.ai, caption: 'Assistants grounded in real answers' },
];
---

<div class="career-line" role="img" aria-label="Career line: Java, then Python, then DevOps, then AI">
  <svg viewBox="0 0 800 90" preserveAspectRatio="none" class="line-svg" aria-hidden="true">
    <path
      d="M40 45 H760"
      fill="none"
      stroke="var(--rule)"
      stroke-width="3"
      class="line-track"
      pathLength="100"
    />
    <path
      d="M40 45 H760"
      fill="none"
      stroke-width="3"
      class="line-draw"
      pathLength="100"
    />
    {stations.map((s, i) => (
      <circle cx={40 + i * (720 / 3)} cy="45" r="7" class={`station station-${s.key}`} />
    ))}
  </svg>
  <ul class="captions" role="list">
    {stations.map((s) => (
      <li>
        <span class="line-name" data-line={s.key}>{s.label}</span>
        <span class="caption">{s.caption}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .career-line {
    margin: var(--space-4) 0;
  }

  .line-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .line-track {
    opacity: 0.6;
  }

  .line-draw {
    stroke: var(--accent);
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  .career-line.drawn .line-draw {
    animation: draw-line 1.1s ease-out forwards;
  }

  @keyframes draw-line {
    to {
      stroke-dashoffset: 0;
    }
  }

  .station {
    fill: var(--surface);
    stroke-width: 3;
  }

  .station-java { stroke: var(--line-java); }
  .station-python { stroke: var(--line-python); }
  .station-devops { stroke: var(--line-devops); }
  .station-ai { stroke: var(--line-ai); }

  .captions {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    margin: var(--space-1) 0 0;
    padding: 0;
    gap: var(--space-1);
    text-align: center;
  }

  .captions li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .line-name {
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .line-name[data-line='java'] { color: var(--line-java); }
  .line-name[data-line='python'] { color: var(--line-python); }
  .line-name[data-line='devops'] { color: var(--line-devops); }
  .line-name[data-line='ai'] { color: var(--line-ai); }

  .caption {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  @media (max-width: 640px) {
    .captions {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line-draw {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>

<script>
  requestAnimationFrame(() => {
    document.querySelector('.career-line')?.classList.add('drawn');
  });
</script>

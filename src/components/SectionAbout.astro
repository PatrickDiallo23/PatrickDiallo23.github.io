---
import { Image } from 'astro:assets';
import profile from '../assets/profile.svg';
import { site } from '../config/site';
---

<section id="about" aria-labelledby="about-heading">
  <h2 id="about-heading">About</h2>
  <div class="about-grid">
    <Image src={profile} alt={`Portrait of ${site.name}`} width={160} height={160} class="portrait" />
    <div>
      <p>{site.tagline}</p>
      <ul class="facts" role="list">
        <li><strong>Location:</strong> {site.location}</li>
        <li><strong>Languages:</strong> {site.languages.join(', ')}</li>
        {site.availability.open && <li><strong>Availability:</strong> {site.availability.text}</li>}
      </ul>
    </div>
  </div>
</section>

<style>
  section {
    padding: var(--space-5) var(--space-3);
    max-width: 72rem;
    margin: 0 auto;
  }

  .about-grid {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .portrait {
    border-radius: var(--radius);
    flex-shrink: 0;
  }

  .facts {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--ink-muted);
  }
</style>

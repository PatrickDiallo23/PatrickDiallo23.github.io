---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { readingTime } from '../lib/readingTime';

const isProd = import.meta.env.PROD;
const allPosts = await getCollection('blog', (post) => !isProd || !post.data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---

<section id="blog" aria-labelledby="blog-heading">
  <h2 id="blog-heading">Blog</h2>
  <ul class="posts" role="list">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`} class="plate" target="_blank" rel="noopener noreferrer">
          {post.data.cover && (
            <Image
              src={post.data.cover}
              alt=""
              width={480}
              height={270}
              class="thumb"
              loading="lazy"
            />
          )}
          <h3>{post.data.title}</h3>
          <p class="meta">
            {post.data.date.toISOString().slice(0, 10)} · {readingTime(post.body ?? '')} min read
          </p>
          <p>{post.data.summary}</p>
        </a>
      </li>
    ))}
  </ul>
  <a href="/blog/" class="view-all" target="_blank" rel="noopener noreferrer">View all posts</a>
</section>

<style>
  section {
    padding: var(--space-5) var(--gutter);
    max-width: 72rem;
    margin: 0 auto;
  }

  .posts {
    list-style: none;
    margin: var(--space-3) 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-3);
  }

  .posts li {
    max-width: none;
  }

  .posts a {
    height: 100%;
  }

  .posts p {
    margin: 0;
  }

  .thumb {
    display: block;
    width: calc(100% + 2 * var(--space-3));
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: calc(-1 * var(--space-3)) calc(-1 * var(--space-3)) var(--space-2);
    border-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
  }

  .posts h3 {
    margin: 0;
    font-size: var(--text-md);
    color: var(--accent);
  }

  .posts .meta {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin: 0.3rem 0 0.6rem;
  }

  .view-all {
    color: var(--accent);
  }
</style>

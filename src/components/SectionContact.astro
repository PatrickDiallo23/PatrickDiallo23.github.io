---
import { site } from '../config/site';

const { formspreeId, replyTime } = site.contact;

// Brand marks (24px grid). Unknown platforms fall back to a link icon.
const icons: Record<string, string> = {
  github:
    '<path fill="currentColor" d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.39-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>',
  linkedin:
    '<path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/>',
  goodreads:
    '<g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11.5" cy="10" r="5"/><path d="M16.5 4.5v10.5a5.5 5.5 0 0 1-10.2 2.8"/></g>',
};
const fallbackIcon =
  '<path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M10 14a4.5 4.5 0 0 0 6.4 0l3.2-3.2a4.5 4.5 0 0 0-6.4-6.4L12 5.6M14 10a4.5 4.5 0 0 0-6.4 0l-3.2 3.2a4.5 4.5 0 0 0 6.4 6.4L12 18.4"/>';
const labels: Record<string, string> = { github: 'GitHub', linkedin: 'LinkedIn', goodreads: 'Goodreads' };
---

<section id="contact" aria-labelledby="contact-heading">
  <h2 id="contact-heading">Contact</h2>

  <div class="contact-grid">
    <div class="invite">
      <p class="lead">Have an idea, a role, or a question? Let's talk.</p>
      <p class="muted">{replyTime}</p>
      {site.availability.open && (
        <p class="availability"><span class="status-dot" aria-hidden="true"></span>{site.availability.text}</p>
      )}

      {site.socials.length > 0 && (
        <ul class="socials" role="list">
          {site.socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="me noopener noreferrer">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" set:html={icons[s.platform] ?? fallbackIcon} />
                <span>{labels[s.platform] ?? s.platform}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

    </div>

    <div class="plate form-card">
      {formspreeId ? (
        <form id="contact-form" action={`https://formspree.io/f/${formspreeId}`} method="POST" novalidate>
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required maxlength="100" />
            <p class="error" id="name-error" hidden>Please tell me your name.</p>
          </div>
          <div class="field">
            <label for="email">Your email</label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
            <p class="error" id="email-error" hidden>I need a valid email address to reply to you.</p>
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required minlength="10" maxlength="5000"></textarea>
            <p class="error" id="message-error" hidden>A few more words, please (10 characters minimum).</p>
          </div>
          {/* Honeypot: invisible to people; bots fill it and Formspree drops the message. */}
          <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit">Send message</button>
          <p id="form-status" role="status" aria-live="polite"></p>
        </form>
      ) : (
        <div class="pending">
          <p class="lead">The contact form is being set up.</p>
          <p class="muted">Until then, the quickest way to reach me is a message on one of the profiles listed here.</p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  section {
    padding: var(--space-5) var(--gutter);
    max-width: 72rem;
    margin: 0 auto;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  @media (min-width: 820px) {
    .contact-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }

  .lead {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 var(--space-1);
  }

  .muted {
    color: var(--ink-muted);
    margin: 0 0 var(--space-2);
  }

  .availability {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 var(--space-3);
  }

  .status-dot {
    flex-shrink: 0;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--tint-emerald);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--tint-emerald) 25%, transparent);
  }

  .socials {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: 0;
    margin: 0 0 var(--space-3);
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 700;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .socials a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .form-card {
    padding: clamp(var(--space-2), 4vw, var(--space-4));
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  label {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  input,
  textarea {
    font: inherit;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink);
    min-height: 44px;
    width: 100%;
    caret-color: var(--accent);
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--accent);
  }

  [aria-invalid='true'] {
    border-color: var(--tint-crimson);
  }

  .error {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--tint-crimson);
  }

  button[type='submit'] {
    align-self: flex-start;
    background: var(--accent);
    color: var(--surface);
    border: none;
    border-radius: var(--radius);
    padding: 0.7rem 1.4rem;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    min-height: 44px;
  }

  button[type='submit']:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  #form-status {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  #form-status[data-state='error'] {
    color: var(--tint-crimson);
  }

  #form-status[data-state='sent'] {
    color: var(--tint-emerald);
  }

  .pending .lead {
    font-size: var(--text-md);
  }

  @media (max-width: 480px) {
    button[type='submit'] {
      align-self: stretch;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const fields = form ? Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')) : [];

  function setStatus(text: string, state = '') {
    if (!status) return;
    status.textContent = text;
    status.dataset.state = state;
  }

  // Inline validation: a field shows its message once the visitor leaves it or submits.
  function check(field: HTMLInputElement | HTMLTextAreaElement) {
    const ok = field.checkValidity();
    const error = document.getElementById(`${field.id}-error`);
    field.setAttribute('aria-invalid', String(!ok));
    if (error) {
      error.hidden = ok;
      field.setAttribute('aria-describedby', error.id);
    }
    return ok;
  }

  fields.forEach((f) => {
    f.addEventListener('blur', () => check(f));
    f.addEventListener('input', () => {
      if (f.getAttribute('aria-invalid') === 'true') check(f);
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const invalid = fields.filter((f) => !check(f));
    if (invalid.length) {
      invalid[0].focus();
      return;
    }

    if (submit) {
      submit.disabled = true;
      submit.textContent = 'Sending…';
    }
    setStatus('Sending your message…', 'sending');

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      if (!res.ok) throw new Error(`Formspree responded ${res.status}`);
      form.reset();
      fields.forEach((f) => f.removeAttribute('aria-invalid'));
      setStatus('Message sent. Thank you, I will get back to you soon.', 'sent');
    } catch {
      setStatus('That did not go through. Please try again in a minute, or message me on LinkedIn.', 'error');
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.textContent = 'Send message';
      }
    }
  });
</script>

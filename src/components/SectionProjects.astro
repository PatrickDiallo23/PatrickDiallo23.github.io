---
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => b.data.start.localeCompare(a.data.start));
const categories = ['All', ...new Set(projects.map((p) => p.data.category))];
---

<section id="projects" aria-labelledby="projects-heading">
  <h2 id="projects-heading">Projects</h2>
  <div class="filters" role="group" aria-label="Filter projects by category">
    {categories.map((category, i) => (
      <button type="button" class="chip" data-category={category} aria-pressed={i === 0 ? 'true' : 'false'}>
        {category}
      </button>
    ))}
  </div>
  <ul class="grid" role="list">
    {projects.map((p) => (
      <li data-category={p.data.category}>
        <a href={`/projects/${p.id}/`}>
          <h3 data-line={p.data.line}>{p.data.title}</h3>
          <p>{p.data.plain}</p>
          <p class="stack">{p.data.stack.join(', ')}</p>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  section {
    padding: var(--space-5) var(--space-3);
    max-width: 72rem;
    margin: 0 auto;
  }

  .filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: var(--space-2) 0;
  }

  .chip {
    border: 1px solid var(--rule);
    background: none;
    color: var(--ink-muted);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font-size: var(--text-sm);
    cursor: pointer;
    min-height: 44px;
  }

  .chip[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .grid li[hidden] {
    display: none;
  }

  .grid a {
    display: block;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-2);
    text-decoration: none;
    color: var(--ink);
    height: 100%;
  }

  h3[data-line='java'] { color: var(--line-java); }
  h3[data-line='python'] { color: var(--line-python); }
  h3[data-line='devops'] { color: var(--line-devops); }
  h3[data-line='ai'] { color: var(--line-ai); }

  .stack {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin: 0;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('#projects .chip');
  const items = document.querySelectorAll<HTMLLIElement>('#projects .grid li');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');
      const category = chip.dataset.category;
      items.forEach((item) => {
        item.hidden = category !== 'All' && item.dataset.category !== category;
      });
    });
  });
</script>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
const allTags = [...new Set((await getCollection('blog', (p) => !p.data.draft)).flatMap((p) => p.data.tags))];
---

<BaseLayout title="This station doesn't exist" description="Page not found." noindex={true}>
  <Header slot="header" />
  <div class="not-found">
    <h1>This station doesn't exist</h1>
    <p>The page you're looking for isn't on the line. Here's what is:</p>

    <h2>Nearby tags</h2>
    <ul class="tag-list" role="list">
      {(tags.length ? tags : allTags).map((tag) => (
        <li><a href={`/blog/tags/${tag}/`}>#{tag}</a></li>
      ))}
    </ul>

    <h2>Latest posts</h2>
    <ul role="list">
      {posts.map((post) => (
        <li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
      ))}
    </ul>

    <p><a href="/">Back to the home page</a></p>
  </div>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .not-found {
    max-width: 60rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-3);
  }
  .tag-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
  }
  .tag-list a {
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }
  ul {
    padding-left: 1.2rem;
  }
</style>

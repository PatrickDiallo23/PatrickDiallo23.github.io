---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { readingTime } from '../../lib/readingTime';
import { site } from '../../config/site';

const allPosts = await getCollection('blog', (post) => !import.meta.env.PROD || !post.data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout title="Blog" description={`Posts by ${site.name} on backend engineering, data pipelines, DevOps, and AI.`}>
  <Header slot="header" />

  <div class="blog-index">
    <h1>Blog</h1>

    <div class="filters" role="group" aria-label="Filter posts by tag">
      <button type="button" class="chip" data-tag="all" aria-pressed="true">All</button>
      {tags.map((tag) => (
        <button type="button" class="chip" data-tag={tag} aria-pressed="false">
          {tag}
        </button>
      ))}
    </div>

    <ul class="posts" role="list">
      {posts.map((post) => (
        <li data-tags={post.data.tags.join(',')}>
          <a href={`/blog/${post.id}/`} class="post-link">
            <h2>
              <span>{post.data.title}</span>
              <span class="arrow" aria-hidden="true">&rarr;</span>
            </h2>
            <p class="meta">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toISOString().slice(0, 10)}
              </time>
              · {readingTime(post.body ?? '')} min read
              {post.data.tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </p>
            <p class="summary">{post.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .blog-index {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-3);
  }

  .filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: var(--space-2) 0 var(--space-3);
  }

  .chip {
    border: 1px solid var(--rule);
    background: none;
    color: var(--ink-muted);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font-size: var(--text-sm);
    cursor: pointer;
    min-height: 44px;
  }

  .chip[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .posts li {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  .posts li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .posts[hidden-empty]::after {
    content: 'No posts match that tag.';
  }

  .post-link {
    display: block;
    text-decoration: none;
    color: var(--ink);
  }

  .post-link h2 {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    margin: 0 0 0.35rem;
    font-size: var(--text-lg);
    transition: color 0.2s ease;
  }

  .arrow {
    font-family: system-ui, sans-serif;
    font-weight: 400;
    opacity: 0.6;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  .post-link:hover h2 {
    color: var(--accent);
  }

  .post-link:hover .arrow {
    transform: translateX(5px);
    opacity: 1;
    color: var(--accent);
  }

  .meta {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin: 0 0 0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .tag {
    color: var(--accent);
    font-size: var(--text-sm);
    opacity: 0.85;
  }

  .summary {
    margin: 0;
    color: var(--ink);
    line-height: 1.6;
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filters .chip');
  const items = document.querySelectorAll<HTMLLIElement>('.posts li');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');
      const tag = chip.dataset.tag;
      items.forEach((item) => {
        const tags = (item.dataset.tags || '').split(',');
        item.hidden = tag !== 'all' && !tags.includes(tag || '');
      });
    });
  });
</script>

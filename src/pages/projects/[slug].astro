---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const projectsVisible = site.sections.find((s) => s.id === 'projects')?.visible ?? false;
  if (!projectsVisible) return [];
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.plain}>
  <Header slot="header" />
  <article class="project">
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <a href="/">Home</a> / <a href="/#projects">Projects</a> / <span aria-current="page">{project.data.title}</span>
    </nav>
    {project.data.image && (
      <Image
        src={project.data.image}
        alt=""
        width={960}
        height={540}
        class="cover"
        loading="eager"
        fetchpriority="high"
      />
    )}

    <h1 data-tint={project.data.tint}>{project.data.title}</h1>
    <p class="meta">
      {project.data.category} · {project.data.start}{project.data.end ? `–${project.data.end}` : ' – present'}
    </p>
    <p>{project.data.plain}</p>
    <p class="stack"><strong>Stack:</strong> {project.data.stack.join(', ')}</p>
    <p class="links">
      {project.data.repo && <a href={project.data.repo}>Repository</a>}
      {project.data.live && <a href={project.data.live}>Live</a>}
      {project.data.paper && <a href={project.data.paper}>Paper</a>}
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .project {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-5) var(--gutter);
  }
  .breadcrumbs {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .cover {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin: var(--space-3) 0;
  }
  h1[data-tint] { color: var(--tint); }
  .meta, .stack {
    color: var(--ink-muted);
  }
  .links a {
    margin-right: var(--space-2);
  }
</style>
